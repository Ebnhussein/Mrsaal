{
  "manifest_version": 3,
  "name": "Mrsaal Scraper",
  "description": "Collect companies and job listings from a page you choose and save them to your Mrsaal account.",
  "version": "0.6.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://mrsaal.ebnhussein.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mrsaal Scraper",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mrsaal.ebnhussein.co/app*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
