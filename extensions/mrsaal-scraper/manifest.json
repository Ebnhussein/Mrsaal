{
  "manifest_version": 3,
  "name": "Mrsaal Scraper | مرسال",
  "description": "Collect companies and job listings from a page you choose and save them to your Mrsaal account.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://mrsaal.ebnhussein.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mrsaal Scraper"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
