# Save actual values in /etc/mrsaal-backup.env with chmod 600. Never commit secrets.
export RESTIC_REPOSITORY='s3:https://YOUR-S3-ENDPOINT/YOUR-BUCKET/mrsaal'
export RESTIC_PASSWORD_FILE='/etc/mrsaal-restic-password'
export AWS_ACCESS_KEY_ID='SET_ON_SERVER'
export AWS_SECRET_ACCESS_KEY='SET_ON_SERVER'
POSTGRES_CONTAINER='YOUR_MRSAAL_POSTGRES_CONTAINER'
PGUSER='YOUR_POSTGRES_USER'
PGDATABASE='YOUR_MRSAAL_DATABASE'
APP_SOURCE='/opt/mrsaal'
APP_ENV_FILE='/path/to/actual/app.env'
