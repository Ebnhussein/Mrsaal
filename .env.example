# Reference only: keep the real values in Coolify, never commit .env.
PORT=3000
NODE_ENV=production
BASE_URL=https://mrsaal.ebnhussein.co
SESSION_SECRET=replace_with_a_long_random_secret

# Existing internal PostgreSQL database; copy real values from Coolify.
PGHOST=replace_with_database_internal_host
PGPORT=5432
PGUSER=replace_with_database_user
PGPASSWORD=replace_with_database_password
PGDATABASE=replace_with_database_name

# Google OAuth
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=https://mrsaal.ebnhussein.co/auth/google/callback

# AI providers: configure at least one real key.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional override; if absent, the list in utils/ai-legacy.js is used.
# AI_MODEL_CHAIN=[{"provider":"openrouter","model":"openrouter/free"}]

# Keep the SAME secret on updates to decrypt saved WhatsApp sessions.
WHATSAPP_AUTH_SECRET=replace_with_random_secret_at_least_32_characters
WHATSAPP_MAX_SESSIONS=10

# Optional encryption secret for new Gmail/AI connections.
# If omitted, SESSION_SECRET is used. Keep its value stable after first deploy.
# CONNECTIONS_SECRET=replace_with_a_long_random_secret

# Comma-separated Google LOGIN emails allowed to administer support; empty grants nobody access.
ADMIN_EMAILS=

# Email/password accounts (optional; Google login remains available).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional public site key. Configure its SECRET in Supabase Auth CAPTCHA settings.
# Enable Confirm email and custom SMTP in Supabase before opening email signup.
TURNSTILE_SITE_KEY=
# Server-only: needed for complete Supabase identity deletion. NEVER put in public assets.
SUPABASE_SERVICE_ROLE_KEY=

# 20 seconds per model / 45 seconds for personal provider chain by default.
AI_MODEL_TIMEOUT_MS=20000
AI_TOTAL_TIMEOUT_MS=45000
